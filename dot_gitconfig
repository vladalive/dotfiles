# Managed by chezmoi (source: dot_gitconfig in vladalive/dotfiles).
#
# Identity and the include list only. Everything else lives in
# ~/.config/git/config.d/, one file per theme, read in the order below; a key
# repeated in a later file wins. Shell bodies for the aliases are real scripts
# in ~/.config/git/bin/.
#
# git has no glob in `[include] path`, so adding a fragment means adding a line
# here.

[user]
  name = Vlad Alive
  email = vladalive@gmail.com

[include]
  path = ~/.config/git/config.d/00-core.gitconfig
  path = ~/.config/git/config.d/10-auth.gitconfig
  path = ~/.config/git/config.d/20-ui.gitconfig
  path = ~/.config/git/config.d/30-diff-merge.gitconfig
  path = ~/.config/git/config.d/40-workflow.gitconfig
  path = ~/.config/git/config.d/50-aliases.gitconfig

  # `git gpg-signingkey-local` writes this host's secret-key ID here. Kept
  # untracked and last so each machine can override anything above.
  path = ~/.gitconfig.local
