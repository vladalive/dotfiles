#!/usr/bin/env ruby
# frozen_string_literal: true

# git branch-remove-merged [--dry-run]
#
# Delete local branches already merged into HEAD, along with any worktree
# checked out on them. "Merged" means either an ancestor of HEAD, or - for a
# squash-merge, which leaves the commits unreachable - the head of a merged
# pull request that is exactly the branch tip (asked of gh; without gh only the
# ancestry half runs).
#
# Four guards, each of which exists because an earlier version of this code
# deleted work that was still in progress:
#
#   - a branch with no commits of its own is skipped while it is younger than
#     48 hours. A branch created and not yet committed to is trivially an
#     ancestor of HEAD, so "merged" says nothing about it: it is a claim
#     somebody has not started filling in. After 48 hours it is an abandoned
#     claim, and keeping it forever is how a hundred empty worktrees piled up.
#   - a worktree with modified or untracked files is skipped.
#   - a worktree that a live process has as its cwd is skipped. A clean worktree
#     an agent opened a minute ago is indistinguishable from an abandoned one.
#   - a worktree holding ignored files that nothing can regenerate is skipped.
#     git does not count ignored files as dirt, so `worktree remove` would take
#     them without a word. Symlinks, whatever .worktrees.yml provisions and
#     the usual build output (tmp, log, coverage, node_modules...) are fine.
#
# Run it with --dry-run first; it prints the same report without touching
# anything.

require 'json'
require 'open3'
require 'yaml'

class BranchRemoveMerged
  PROTECTED = %w[master main develop deploy production staging qa].freeze

  # How long a branch with no commits of its own is treated as a claim somebody
  # is about to fill in.
  EMPTY_GRACE = 48 * 3600

  # Ignored paths that a build or a test run recreates; losing them costs time,
  # not work.
  REGENERABLE = %w[
    tmp log coverage node_modules .bundle .ruby-lsp .codegraph
    .playwright-cli .playwright-mcp vendor/bundle public/packs public/assets
  ].freeze

  GitError = Class.new(StandardError)

  def initialize(dry_run:, out: $stdout, err: $stderr)
    @dry_run = dry_run
    @out = out
    @err = err
    @removed_branches = 0
    @removed_worktrees = 0
    @skipped = 0
    @found = false
    @squash_merged = []
  end

  def run
    candidates.each { |branch| consider(branch) }
    report
    0
  rescue GitError => e
    @err.puts e.message
    1
  end

  private

  attr_reader :dry_run, :out

  def candidates
    current = git('branch', '--show-current').strip

    merged = git('for-each-ref', '--format=%(refname:short)', 'refs/heads', '--merged')
             .lines(chomp: true)
             .map(&:strip)
             .reject(&:empty?)

    @squash_merged = squash_merged_branches - merged

    (merged + @squash_merged)
      .reject { |branch| PROTECTED.include?(branch) || branch == current }
  end

  # A squash-merge never makes the branch's commits reachable from HEAD, so
  # --merged cannot see it; the merged PR is the only record. Trust it only when
  # the PR's head is exactly the local tip - commits added after the merge are
  # work the PR never had, and keep the branch alive.
  def squash_merged_branches
    heads = merged_pr_heads
    return [] if heads.empty?

    git('for-each-ref', '--format=%(refname:short) %(objectname)', 'refs/heads')
      .lines(chomp: true)
      .map(&:split)
      .select { |branch, tip| heads.fetch(branch, []).include?(tip) }
      .map(&:first)
  end

  def merged_pr_heads
    stdout, stderr, status = Open3.capture3(
      ENV.fetch('BRANCH_REMOVE_MERGED_GH', 'gh'),
      'pr', 'list', '--state', 'merged', '--limit', '1000', '--json', 'headRefName,headRefOid'
    )
    return gh_unavailable(stderr) unless status.success?

    JSON.parse(stdout).each_with_object(Hash.new { |hash, key| hash[key] = [] }) do |pr, heads|
      heads[pr['headRefName']] << pr['headRefOid']
    end
  rescue SystemCallError, JSON::ParserError => e
    gh_unavailable(e.message)
  end

  def gh_unavailable(reason)
    @err.puts "gh could not list merged pull requests, so squash-merged branches were not checked: #{reason.to_s.strip}"
    {}
  end

  def consider(branch)
    @found = true

    if !own_commits?(branch) && fresh?(branch)
      skip(branch, 'no commits of its own yet (still fresh/claimed)')
      return
    end

    worktrees = worktrees_for(branch)
    blocker = worktrees.lazy.filter_map { |worktree| blocker_for(worktree) }.first
    return skip(branch, blocker[:reason], blocker[:detail]) if blocker

    worktrees.each { |worktree| git('worktree', 'remove', worktree) } unless dry_run
    remove(branch, worktrees)
  end

  # A branch someone just created points at an existing commit and has no
  # reflog entry of its own; `git reflog show` records ": commit" only once
  # something has actually been committed on it.
  def own_commits?(branch)
    stdout, status = Open3.capture2('git', 'reflog', 'show', branch, err: File::NULL)
    status.success? && stdout.include?(': commit')
  end

  # Seconds since the branch's oldest reflog entry. A branch with no reflog at
  # all cannot be dated, and what cannot be dated is treated as fresh.
  def fresh?(branch)
    stdout, status = Open3.capture2('git', 'reflog', 'show', '--date=unix', '--format=%gd', branch, err: File::NULL)
    created = status.success? ? stdout.lines.last.to_s[/@\{(\d+)\}/, 1] : nil

    created.nil? || Time.now.to_i - created.to_i < EMPTY_GRACE
  end

  def worktrees_for(branch)
    path = nil

    git('worktree', 'list', '--porcelain').each_line(chomp: true).with_object([]) do |line, found|
      case line
      when /\Aworktree (.+)\z/ then path = Regexp.last_match(1)
      when "branch refs/heads/#{branch}" then found << path if path
      end
    end
  end

  def blocker_for(worktree)
    if git('-C', worktree, 'status', '--porcelain').strip != ''
      return {
        reason: 'worktree has modified or untracked files',
        detail: ["  #{worktree}", git('-C', worktree, 'status', '--short').chomp]
      }
    end

    if live_process_in?(worktree)
      return { reason: 'a live process has its cwd inside the worktree', detail: ["  #{worktree}"] }
    end

    irreplaceable = irreplaceable_ignored(worktree)
    return if irreplaceable.empty?

    { reason: 'worktree holds ignored files that nothing regenerates',
      detail: irreplaceable.map { |path| "  #{worktree}/#{path}" } }
  end

  def irreplaceable_ignored(worktree)
    provisioned = provisioned_paths(worktree)

    git('-C', worktree, 'status', '--porcelain', '-z', '--ignored')
      .split("\0")
      .filter_map { |entry| entry[3..] if entry.start_with?('!! ') }
      .reject { |path| replaceable?(worktree, path, provisioned) }
  end

  def replaceable?(worktree, path, provisioned)
    bare = path.chomp('/')

    covers = ->(prefix) { bare == prefix || bare.start_with?("#{prefix}/") }
    return true if REGENERABLE.any?(&covers) || provisioned.any?(&covers)

    only_symlinks?(File.join(worktree, bare))
  end

  def only_symlinks?(path)
    return true if File.symlink?(path)
    return false unless File.directory?(path)

    Dir.glob(File.join(path, '**', '*'), File::FNM_DOTMATCH)
       .reject { |entry| %w[. ..].include?(File.basename(entry)) }
       .all? { |entry| File.symlink?(entry) || File.directory?(entry) }
  end

  # What `git worktrees sync` puts in a new worktree, so it is by definition
  # something sync can put back. The file is usually untracked and so lives only
  # in the main checkout, never in the worktree being judged.
  def provisioned_paths(worktree)
    config = [worktree, main_checkout(worktree)].compact
                                                .map { |root| File.join(root, '.worktrees.yml') }
                                                .find { |path| File.file?(path) }
    return [] unless config

    declared = YAML.safe_load_file(config) || {}
    %w[link copy].flat_map { |section| Array(declared[section]) }.map { |path| path.to_s.chomp('/') }
  rescue SystemCallError, Psych::Exception
    []
  end

  def main_checkout(worktree)
    common = git('-C', worktree, 'rev-parse', '--path-format=absolute', '--git-common-dir').strip
    File.dirname(common) if File.basename(common) == '.git'
  end

  def live_process_in?(worktree)
    root = File.realpath(worktree)

    Dir.glob('/proc/[0-9]*/cwd').any? do |link|
      cwd = resolve(link)
      !cwd.nil? && (cwd == root || cwd.start_with?("#{root}/"))
    end
  rescue SystemCallError
    false
  end

  def resolve(link)
    File.realpath(link)
  rescue SystemCallError
    nil
  end

  def remove(branch, worktrees)
    count = worktrees.size
    label = count == 1 ? 'worktree' : 'worktrees'

    suffix = count.positive? ? " (and #{count} #{label})" : ''
    suffix += ' [squash-merged]' if @squash_merged.include?(branch)

    if dry_run
      out.puts "Would remove #{branch}#{suffix}"
      worktrees.each { |worktree| out.puts "  #{worktree}" }
    else
      git('branch', '-D', branch)
      out.puts "Removed #{branch}#{suffix}"
    end

    @removed_branches += 1
    @removed_worktrees += count
  end

  def skip(branch, reason, detail = [])
    out.puts "Skipping #{branch}: #{reason}"
    detail.each { |line| out.puts line }
    @skipped += 1
  end

  def report
    return out.puts 'No merged branches to remove.' unless @found

    verb = dry_run ? 'Would remove' : 'Removed'
    out.puts "#{verb} #{@removed_branches} merged #{plural(@removed_branches, 'branch', 'branches')} " \
             "and #{@removed_worktrees} #{plural(@removed_worktrees, 'worktree', 'worktrees')}."

    return if @skipped.zero?

    out.puts "Skipped #{@skipped} merged #{plural(@skipped, 'branch', 'branches')} with dirty " \
             'worktrees, live processes, or no commits of their own.'
  end

  def plural(count, singular, plural)
    count == 1 ? singular : plural
  end

  def git(*args)
    stdout, stderr, status = Open3.capture3('git', *args)
    raise GitError, "git #{args.join(' ')} failed: #{stderr.strip}" unless status.success?

    stdout
  end
end

if $PROGRAM_NAME == __FILE__
  argv = ARGV.dup
  dry_run = !argv.delete('--dry-run').nil?

  unless argv.empty?
    warn 'usage: git branch-remove-merged [--dry-run]'
    exit 1
  end

  exit BranchRemoveMerged.new(dry_run: dry_run).run
end
