# Aliases.
#
# Anything with a shell body is a real script in ~/.config/git/bin/ and the
# alias is only its entry point. Bodies stopped living here because git's
# config quoting had already silently corrupted several of them.
#
# Declarative one-liners stay inline - there is nothing to escape.

[alias]

  # Branch names this repository uses. Every alias below reads them through
  # these rather than hardcoding "master", so a repo on `develop` or `trunk`
  # only has to set branches.* once.
  env-branch-master           = config --get --default master branches.master
  env-branch-develop          = config --get --default develop branches.develop
  env-branch-staging          = config --get --default staging branches.staging
  env-branch-production       = config --get --default production branches.production

  # Status, branches, checkout.
  s                           = status
  b                           = branch
  c                           = checkout
  cm                          = "!git checkout $(git env-branch-master)"
  cd                          = "!git checkout $(git env-branch-develop)"
  cw                          = "!~/.config/git/bin/git-cw"
  cg                          = "!~/.config/git/bin/git-cg"

  # Diff.
  d                           = diff
  dw                          = diff -b -w
  dc                          = diff -b --cached
  ds                          = diff -b --stat
  dst                         = diff --staged
  dn                          = diff --name-only
  dm                          = "!git diff $(git env-branch-master)..."
  dd                          = "!git diff $(git env-branch-develop)..."
  ddst                        = "!git diff --stat $(git env-branch-develop)..."

  # Commit.
  co                          = commit
  com                         = commit -m
  cof                         = commit -m 'f'
  cofam                       = commit --amend --no-edit
  rcom                        = "!~/.config/git/bin/git-rcom"

  # Rebase.
  rebm                        = "!git rebase $(git env-branch-master)"
  rebd                        = "!git rebase $(git env-branch-develop)"
  rebp                        = rebase production
  rebim                       = "!git rebase -i $(git env-branch-master)"
  rebid                       = "!git rebase -i $(git env-branch-develop)"
  rebip                       = "!git rebase -i $(git env-branch-production)"
  rebi                        = rebase -i
  rebi1                       = rebase -i HEAD~1
  rebi2                       = rebase -i HEAD~2
  rebi3                       = rebase -i HEAD~3
  rebi4                       = rebase -i HEAD~4
  rebi5                       = rebase -i HEAD~5

  # Show a commit N back.
  show0                       = show HEAD~0
  show1                       = show HEAD~1
  show2                       = show HEAD~2
  show3                       = show HEAD~3
  show4                       = show HEAD~4
  show5                       = show HEAD~5

  # Log. `ps` is what a push would send; `w`/`wo` are log with diffs.
  ps                          = log --oneline origin...
  w                           = whatchanged -p
  wo                          = whatchanged -p origin...
  lo                          = log --oneline
  lom                         = "!git log --oneline $(git env-branch-master).."
  lod                         = "!git log --oneline $(git env-branch-develop).."
  lop                         = "!git log --oneline $(git env-branch-production).."
  lm                          = log --pretty=format:'%an | %s'
  lmd                         = log --author="$(git config user.name)" --since='1 day'
  lmw                         = log --author="$(git config user.name)" --since='1 week'
  lmm                         = log --author="$(git config user.name)" --since='1 month'
  lg                          = log --graph --all --abbrev-commit --decorate --date=relative \
    --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset'
  last                        = log -1 HEAD --stat
  logsum                      = shortlog --numbered --summary --email
  log-my-branches             = "!~/.config/git/bin/git-log-my-branches"

  # Grep.
  g                           = grep --break --heading --line-number
  gn                          = grep --name-only
  grepa                       = grep -A 5
  grepb                       = grep -B 5
  grepc                       = grep -C 5
  logrep                      = "!~/.config/git/bin/git-logrep"
  grep-replace                = "!~/.config/git/bin/git-grep-replace"
  grep-lang                   = "!~/.config/git/bin/git-grep-lang"
  grep-ruby                   = "!~/.config/git/bin/git-grep-lang ruby"
  grep-html                   = "!~/.config/git/bin/git-grep-lang html"
  grep-css                    = "!~/.config/git/bin/git-grep-lang css"
  grep-js                     = "!~/.config/git/bin/git-grep-lang js"

  # Files git has been told to stop noticing.
  assume-unchanged-files      = "!~/.config/git/bin/git-assume-unchanged-files"
  assume-unchanged-set        = update-index --assume-unchanged
  assume-unchanged-unset      = update-index --no-assume-unchanged

  # Remotes, and branch cleanup. branch-remove-merged deletes worktrees as
  # well as branches - run it with --dry-run first.
  up                          = pull --rebase --autostash
  pushfl                      = "!~/.config/git/bin/git-pushfl"
  create-pull-request         = !sh -c 'stash pull-request $0 $@'
  branch-upstream             = "!~/.config/git/bin/git-branch-upstream"
  branch-remove-merged        = "!~/.config/git/bin/git-branch-remove-merged"
  branch-remove-merged-remote = "!~/.config/git/bin/git-branch-remove-merged-remote"

  # Signing key for this host, written to the untracked ~/.gitconfig.local.
  gpg-signingkey-local        = "!~/.config/git/bin/git-gpg-signingkey-local"
