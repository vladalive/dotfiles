# Aliases.
#
# Anything with a shell body is a real script in ~/.config/git/bin/ and the
# alias is only its entry point. Bodies stopped living here because git's
# config quoting had already silently corrupted several of them.
#
# Declarative one-liners stay inline - there is nothing to escape.

[alias]

  # Branch names this repository uses. Every alias below reads them through
  # these rather than hardcoding "master", so a repo on `develop` or `trunk`
  # only has to set branches.* once.
  env-branch-master           = config --get --default master branches.master
  env-branch-develop          = config --get --default develop branches.develop
  env-branch-staging          = config --get --default staging branches.staging
  env-branch-production       = config --get --default production branches.production

  # Status, branches, checkout.
  s                           = status
  b                           = branch
  c                           = checkout
  cm                          = "!git checkout $(git env-branch-master)"
  cd                          = "!git checkout $(git env-branch-develop)"
  cw                          = "!~/.config/git/bin/git-cw"
  cg                          = "!~/.config/git/bin/git-cg"

  # Diff.
  d                           = diff
  dw                          = diff -b -w
  dc                          = diff -b --cached
  ds                          = diff -b --stat
  dst                         = diff --staged
  dn                          = diff --name-only
  dm                          = "!git diff $(git env-branch-master)..."
  dd                          = "!git diff $(git env-branch-develop)..."
  ddst                        = "!git diff --stat $(git env-branch-develop)..."

  # Commit.
  co                          = commit
  com                         = commit -m
  cof                         = commit -m 'f'
  cofam                       = commit --amend --no-edit
  rcom                        = "!~/.config/git/bin/git-rcom"

  # Rebase.
  rebm                        = "!git rebase $(git env-branch-master)"
  rebd                        = "!git rebase $(git env-branch-develop)"
  rebp                        = rebase production
  rebim                       = "!git rebase -i $(git env-branch-master)"
  rebid                       = "!git rebase -i $(git env-branch-develop)"
  rebip                       = "!git rebase -i $(git env-branch-production)"
  rebi                        = rebase -i
  rebi1                       = rebase -i HEAD~1
  rebi2                       = rebase -i HEAD~2
  rebi3                       = rebase -i HEAD~3
  rebi4                       = rebase -i HEAD~4
  rebi5                       = rebase -i HEAD~5

  # Show a commit N back.
  show0                       = show HEAD~0
  show1                       = show HEAD~1
  show2                       = show HEAD~2
  show3                       = show HEAD~3
  show4                       = show HEAD~4
  show5                       = show HEAD~5

  # Log. `ps` is what a push would send; `w`/`wo` are log with diffs.
  ps                          = log --oneline origin...
  w                           = whatchanged -p
  wo                          = whatchanged -p origin...
  lo                          = log --oneline
  lom                         = "!git log --oneline $(git env-branch-master).."
  lod                         = "!git log --oneline $(git env-branch-develop).."
  lop                         = "!git log --oneline $(git env-branch-production).."
  lm                          = log --pretty=format:'%an | %s'
  lmd                         = log --author="$(git config user.name)" --since='1 day'
  lmw                         = log --author="$(git config user.name)" --since='1 week'
  lmm                         = log --author="$(git config user.name)" --since='1 month'
  lg                          = log --graph --all --abbrev-commit --decorate --date=relative \
    --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset'
  last                        = log -1 HEAD --stat
  logsum                      = shortlog --numbered --summary --email
  log-my-branches             = "!f() { \
    PERIOD=${1:-week} ;\
    SINCE=\"1 $PERIOD ago\" ;\
    AUTHOR=$(git config user.name) ;\
    BRANCHES=$(git branch|perl -pe 's/^..//') ;\
    echo \"my branches since $SINCE:\" ;\
    for k in $BRANCHES; do \
      COMMIT=$(git show --since=\"$SINCE\" --author=\"$AUTHOR\" --pretty=format:\"%Cgreen%ci %Cblue%cr%Creset\" $k|head -n 1) ;\
      RESULT="$COMMIT\\\t$k" ;\
      echo $RESULT ;\
    done|sort -r| grep : ;\
  }; f"

  # Grep.
  g                           = grep --break --heading --line-number
  gn                          = grep --name-only
  grepa                       = grep -A 5
  grepb                       = grep -B 5
  grepc                       = grep -C 5
  logrep                      = "!~/.config/git/bin/git-logrep"
  grep-replace                = "!f() { \
    git grep -l \"$1\" | xargs -r sed -i "s/$1/$2/g" ;\
  }; f"
  grep-lang                   = "!~/.config/git/bin/git-grep-lang"
  grep-ruby                   = "!~/.config/git/bin/git-grep-lang ruby"
  grep-html                   = "!~/.config/git/bin/git-grep-lang html"
  grep-css                    = "!~/.config/git/bin/git-grep-lang css"
  grep-js                     = "!~/.config/git/bin/git-grep-lang js"

  # Files git has been told to stop noticing.
  assume-unchanged-files      = "!~/.config/git/bin/git-assume-unchanged-files"
  assume-unchanged-set        = update-index --assume-unchanged
  assume-unchanged-unset      = update-index --no-assume-unchanged

  # Remotes, and branch cleanup. branch-remove-merged deletes worktrees as
  # well as branches - run it with --dry-run first.
  up                          = pull --rebase --autostash
  pushfl                      = "!~/.config/git/bin/git-pushfl"
  create-pull-request         = !sh -c 'stash pull-request $0 $@'
  branch-upstream             = "!~/.config/git/bin/git-branch-upstream"
  branch-remove-merged        = "!f() {\n  IGNORED_BRANCHES='master|main|develop|deploy|production|staging|qa'\n  DRY_RUN=0\n  if [ \"$1\" = '--dry-run' ]; then\n    DRY_RUN=1\n    shift\n  fi\n  CURRENT_BRANCH=$(git branch --show-current)\n  FOUND_BRANCHES=0\n  REMOVED_BRANCHES=0\n  REMOVED_WORKTREES=0\n  SKIPPED_BRANCHES=0\n\n  worktree_has_live_process() {\n    WT=\"$1\"\n    for cwd_link in /proc/[0-9]*/cwd; do\n      [ -e \"$cwd_link\" ] || continue\n      RESOLVED=$(readlink -f \"$cwd_link\" 2>/dev/null) || continue\n      case \"$RESOLVED\" in\n        \"$WT\"|\"$WT\"/*) return 0 ;;\n      esac\n    done\n    return 1\n  }\n\n  branch_has_own_commits() {\n    git reflog show \"$1\" 2>/dev/null | grep -q ': commit'\n  }\n\n  for BRANCH in $(git for-each-ref --format='%(refname:short)' refs/heads --merged); do\n    if echo \"$BRANCH\" | grep -Eq \"^($IGNORED_BRANCHES)$\" || [ \"$BRANCH\" = \"$CURRENT_BRANCH\" ]; then\n      continue\n    fi\n    git merge-base --is-ancestor \"$BRANCH\" HEAD || continue\n    FOUND_BRANCHES=1\n\n    if ! branch_has_own_commits \"$BRANCH\"; then\n      echo \"Skipping $BRANCH: no commits of its own yet (still fresh/claimed)\"\n      SKIPPED_BRANCHES=$((SKIPPED_BRANCHES + 1))\n      continue\n    fi\n\n    WORKTREE_COUNT=0\n    WORKTREES=$(git worktree list --porcelain | awk -v branch=\"refs/heads/$BRANCH\" 'BEGIN { path = \"\" } /^worktree / { path = substr($0, 10) } /^branch / { if ($2 == branch) print path }')\n    if [ -n \"$WORKTREES\" ]; then\n      echo \"$WORKTREES\" | while read -r WORKTREE; do\n        [ -z \"$WORKTREE\" ] && continue\n        if [ -n \"$(git -C \"$WORKTREE\" status --porcelain)\" ]; then\n          echo \"Skipping $BRANCH: worktree has modified or untracked files\"\n          echo \"  $WORKTREE\"\n          git -C \"$WORKTREE\" status --short\n          exit 2\n        fi\n        if worktree_has_live_process \"$WORKTREE\"; then\n          echo \"Skipping $BRANCH: a live process has its cwd inside the worktree\"\n          echo \"  $WORKTREE\"\n          exit 3\n        fi\n      done\n      STATUS=$?\n      if [ \"$STATUS\" -eq 2 ] || [ \"$STATUS\" -eq 3 ]; then\n        SKIPPED_BRANCHES=$((SKIPPED_BRANCHES + 1))\n        continue\n      elif [ \"$STATUS\" -ne 0 ]; then\n        exit 1\n      fi\n      echo \"$WORKTREES\" | while read -r WORKTREE; do\n        [ -z \"$WORKTREE\" ] && continue\n        if [ \"$DRY_RUN\" -eq 1 ]; then\n          :\n        else\n          git worktree remove \"$WORKTREE\" || exit 1\n        fi\n      done || exit 1\n      WORKTREE_COUNT=$(echo \"$WORKTREES\" | sed '/^$/d' | wc -l | tr -d ' ')\n    fi\n    WORKTREE_LABEL=worktree\n    [ \"$WORKTREE_COUNT\" -eq 1 ] || WORKTREE_LABEL=worktrees\n    if [ \"$DRY_RUN\" -eq 1 ]; then\n      if [ \"$WORKTREE_COUNT\" -gt 0 ]; then\n        echo \"Would remove $BRANCH (and $WORKTREE_COUNT $WORKTREE_LABEL)\"\n        echo \"$WORKTREES\" | sed '/^$/d; s/^/  /'\n      else\n        echo \"Would remove $BRANCH\"\n      fi\n    else\n      git branch -D \"$BRANCH\" >/dev/null || exit 1\n      if [ \"$WORKTREE_COUNT\" -gt 0 ]; then\n        echo \"Removed $BRANCH (and $WORKTREE_COUNT $WORKTREE_LABEL)\"\n      else\n        echo \"Removed $BRANCH\"\n      fi\n    fi\n    REMOVED_BRANCHES=$((REMOVED_BRANCHES + 1))\n    REMOVED_WORKTREES=$((REMOVED_WORKTREES + WORKTREE_COUNT))\n  done\n\n  if [ \"$FOUND_BRANCHES\" -eq 1 ]; then\n    BRANCH_LABEL=branch\n    [ \"$REMOVED_BRANCHES\" -eq 1 ] || BRANCH_LABEL=branches\n    WORKTREE_LABEL=worktree\n    [ \"$REMOVED_WORKTREES\" -eq 1 ] || WORKTREE_LABEL=worktrees\n    if [ \"$DRY_RUN\" -eq 1 ]; then\n      echo \"Would remove $REMOVED_BRANCHES merged $BRANCH_LABEL and $REMOVED_WORKTREES $WORKTREE_LABEL.\"\n    else\n      echo \"Removed $REMOVED_BRANCHES merged $BRANCH_LABEL and $REMOVED_WORKTREES $WORKTREE_LABEL.\"\n    fi\n    if [ \"$SKIPPED_BRANCHES\" -gt 0 ]; then\n      SKIPPED_LABEL=branch\n      [ \"$SKIPPED_BRANCHES\" -eq 1 ] || SKIPPED_LABEL=branches\n      echo \"Skipped $SKIPPED_BRANCHES merged $SKIPPED_LABEL with dirty worktrees, live processes, or no commits of their own.\"\n    fi\n  else\n    echo 'No merged branches to remove.'\n  fi\n}; f"
  branch-remove-merged-remote = "!f() { \
    REMOTE=\"${1:-origin}\" ;\
    IGNORED_BRANCHES='master|main|develop|deploy|production|staging|qa|backup' ;\
    git fetch \"$REMOTE\" ;\
    MERGED_BRANCHES=$(git branch -r --merged | grep \"$REMOTE/\" | sed \"s# *$REMOTE/##\" | grep -v -E \"($IGNORED_BRANCHES)\") ;\
    if [ -n \"$MERGED_BRANCHES\" ]; then \
      DELETE_CMD=$(echo \"$MERGED_BRANCHES\" | sed \"s/^/:/\" | tr '\n' ' ') ;\
      git push \"$REMOTE\" $DELETE_CMD ;\
    else \
      echo \"No merged branches to delete.\" ;\
    fi ;\
  }; f"

  # Signing key for this host, written to the untracked ~/.gitconfig.local.
  gpg-signingkey-local        = "!~/.config/git/bin/git-gpg-signingkey-local"
